# Server-only Supabase Edge Function settings. Copy outside this repository,
# protect with chmod 600, fill values, and register with `supabase secrets set`.
# Never put these values in desktop or website build variables.
PADDLE_BILLING_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_BILLING_WEB_ORIGIN=https://bandal.io
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
# Comma-separated verified Supabase user UUIDs. Empty denies all billing users.
PADDLE_SANDBOX_ALLOWED_USER_IDS=
