{
  "manifestVersion": 2,
  "id": "bandal.material-summary",
  "name": "자료 개요",
  "version": "1.0.0",
  "minAppVersion": "0.42.0",
  "author": "Bandal",
  "description": "자료 메뉴에서 텍스트의 첫 부분과 글자 수를 별도 패널로 확인합니다.",
  "main": "main.js",
  "permissions": ["commands", "menus", "materials.read", "panel", "settings", "notices"],
  "contributes": {
    "commands": [{ "id": "preview", "title": "자료 개요 열기" }],
    "menus": [{ "location": "materials", "command": "preview" }],
    "panels": [{ "id": "summary", "title": "자료 개요", "entry": "index.html" }],
    "settings": [{ "key": "previewLength", "title": "미리보기 글자 수", "type": "number", "min": 100, "max": 10000, "default": 1000 }]
  }
}
