{
  "manifestVersion": 1,
  "id": "bandal.word-count",
  "name": "단어 수",
  "version": "1.0.0",
  "minAppVersion": "0.36.0",
  "description": "현재 과목의 필기별 단어 수와 글자 수를 계산합니다.",
  "author": "Bandal",
  "main": "main.js",
  "permissions": [
    "courses.read",
    "notes.read",
    "commands",
    "panel",
    "notices"
  ],
  "contributes": {
    "commands": [
      {
        "id": "count-current",
        "title": "현재 과목 필기 단어 수",
        "defaultChord": null
      }
    ],
    "panels": [
      {
        "id": "stats",
        "title": "단어 수",
        "entry": "index.html"
      }
    ]
  },
  "styles": "styles.css"
}
