# Bandal — 환경 변수 예시. 실제 값은 .env.local 에 넣는다(gitignored).
#
# 이 두 값이 없어도 앱은 정상 빌드·실행된다. 없으면 인증 phase 가
# 'unconfigured' 가 되고 "함께하기" UI 가 아예 렌더되지 않는다(비활성화가 아니라
# 부재). 기여자가 키 없이 클론해서 빌드할 수 있어야 한다는 요구가 여기서
# 충족된다 (docs/phase2-community.md §1.4-4 / §7.1).
#
# ⚠ 반드시 MAIN_VITE_ 접두사를 쓸 것. electron-vite 는 이 접두사만 메인 프로세스
#   번들에 노출한다. VITE_ 로 쓰면 렌더러 번들에도 들어가고, 렌더러는 임의 웹을
#   로드하는 <webview> 를 품으므로 Supabase 를 몰라야 한다 (§4.2).
#
# 🚨 service_role 키는 이 파일이나 앱 빌드 환경에 넣지 않는다. RLS 를 전부
#   우회하므로 데스크톱 앱에 들어가면 모든 사용자의 데이터가 열린다.
#   마켓플레이스 서버 전용 비밀 관리 설정은 docs/marketplace.md 를 참고한다.
MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_PUBLISHABLE_KEY=

# 선택 사항: 운영 마켓플레이스의 HTTPS origin. 비어 있으면 로컬 플러그인과
# 기존 공식 카탈로그는 유지되고 온라인 개발자·심사 기능만 연결되지 않는다.
MAIN_VITE_MARKETPLACE_URL=
