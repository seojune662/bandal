{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "web-demo/bootstrap.ts",
    "web-demo/mediaUrl.ts",
    "server/marketplace/index.ts",
    "sdk/cli/index.ts",
    "src/renderer/src/{main,overlay-main,pip-main,settings-main}.tsx",
    "scripts/**/*.mjs",
    "e2e/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "examples/plugins/**/*.js"
  ],
  "project": [
    "src/**/*.{ts,tsx,mts,mjs}",
    "web-demo/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "e2e/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "examples/plugins/**/*.js"
  ],
  "ignore": [
    "src/shared/brandMark.d.mts",
    "src/shared/brandMark.ts"
  ],
  "ignoreDependencies": [
    "@milkdown/exception"
  ],
  "ignoreBinaries": [
    "swift",
    "lipo",
    "supabase",
    "iconutil",
    "plutil",
    "where.exe"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/main/features/browser/index.ts": ["exports"],
    "src/renderer/src/features/ink/ImageShape.tsx": ["exports"],
    "src/renderer/src/features/ink/index.ts": ["exports"],
    "src/shared/account/nickname.ts": ["exports"],
    "src/shared/types/browserProfile.ts": ["exports"],
    "src/shared/types/whiteboard.ts": ["types"]
  }
}
