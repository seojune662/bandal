{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "web-demo/bootstrap.ts",
    "web-demo/mediaUrl.ts",
    "server/marketplace/index.ts",
    "sdk/cli/index.ts",
    "src/renderer/src/{main,overlay-main,pip-main,settings-main}.tsx",
    "scripts/**/*.mjs",
    "e2e/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "examples/plugins/**/*.js"
  ],
  "project": [
    "src/**/*.{ts,tsx,mts,mjs}",
    "web-demo/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "e2e/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "examples/plugins/**/*.js"
  ],
  "ignore": [
    "src/shared/brandMark.d.mts",
    "src/shared/brandMark.ts"
  ],
  "ignoreDependencies": [
    "@milkdown/exception"
  ],
  "ignoreBinaries": [
    "initdb",
    "pg_ctl",
    "psql",
    "supabase",
    "iconutil",
    "plutil",
    "where.exe"
  ],
  "ignoreExportsUsedInFile": true
}
