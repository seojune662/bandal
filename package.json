{
  "name": "bandal",
  "version": "0.7.1",
  "description": "Bandal (반달) — a study IDE for university students",
  "main": "./out/main/index.js",
  "author": "Bandal",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "dist": "electron-vite build && electron-builder --mac",
    "test": "vitest run --exclude \"e2e/**\"",
    "e2e": "electron-vite build && playwright test -c e2e",
    "generate-icon": "node scripts/generate-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:unsigned": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg:arm64 -c.mac.notarize=false -c.mac.identity=null"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.1",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@milkdown/core": "^7.15.0",
    "@milkdown/ctx": "^7.15.0",
    "@milkdown/plugin-history": "^7.15.0",
    "@milkdown/preset-commonmark": "^7.15.0",
    "@milkdown/preset-gfm": "^7.15.0",
    "@milkdown/prose": "^7.15.0",
    "@milkdown/react": "^7.15.0",
    "@milkdown/transformer": "^7.15.0",
    "@milkdown/utils": "^7.15.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "better-sqlite3-node": "npm:better-sqlite3@^12.2.0",
    "canvas": "^3.2.3",
    "dockview": "^4.4.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "immer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.8.69",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.2.1",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "zustand": "^5.0.5"
  }
}
